    class SpaceController {
      <<RestController - PUBLIC>>
      +GET  /api/v1/spaces/{roomId}                    FR-14 / AC-19..AC-21
      +PUT  /api/v1/spaces/{roomId}/preferred-style    FR-14 / AC-22..AC-26
      -requireUserId(userId)
      -loadAndAuthorize(roomId, userId) Space
      -toResponse(Space) SpaceResponse
      %% @CrossOrigin - PUBLIC OpenAPI surface (unlike /internal/v1/*)
    }

    class AIOrchestratorController {
      <<RestController - INTERNAL - Task 3>>
      +POST /internal/v1/spaces/{roomId}/analyze
    }

    class AIOrchestrator {
      <<Service - UPDATED Task 4>>
      -persistence: SpaceAnalysisPersistence
      -spaceClient: SpaceAnalysisClient
      -styleClient: StyleAnalysisClient            NEW FR-8
      -aiExecutor: Executor                         NEW FR-11
      +analyze(roomId) SpaceAnalysisResultDTO
      -unwrap(Throwable) AIException
      -unwrapOrNull(Throwable) AIException
      %% FR-11: CompletableFuture.supplyAsync x 2 + allOf().join()
      %% FR-12: four-way partial-success branching
    }

    class StyleAnalysisClient {
      <<Component - NEW Task 4>>
      -restClient: RestClient
      -baseUrl: String
      -objectMapper: ObjectMapper
      +callStyleAnalysis(roomId, photoUrl) StyleAnalysisResponse
      %% FR-8 / AC-11 - (String,String) -> DTO
      %% timeouts connect 2s / read 10s via app.ai.style.*
    }

    class SpaceAnalysisClient {
      <<Component - Task 3>>
      +callSpaceAnalysis(roomId, photoUrl) SpaceAnalysisResponse
    }

    class AiExecutorConfig {
      <<Configuration - NEW Task 4>>
      +aiExecutor(core, max, queue) Executor
      %% FR-11 - ThreadPoolTaskExecutor
