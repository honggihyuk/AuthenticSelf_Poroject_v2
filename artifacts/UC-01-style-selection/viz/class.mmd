    class FastAPIApp {
      <<FastAPI>>
      +title = "AuthenticSelf AI - Space Analysis"
      +GET  /health                         Task 3 FR-2
      +POST /analyze/space                  Task 3 FR-3
      +POST /analyze/style                  Task 4 FR-1 / AC-1  NEW ACTIVE
      -include_router(style_router)
      -exception_handler RequestValidationError -> INVALID_REQUEST
      -exception_handler AnalyzerError -> 422 envelope
      -exception_handler Exception -> INTERNAL_ERROR 500
    }

    class StyleRouter {
      <<APIRouter>>
      +async analyze_style(request, body, classifier) StyleAnalysisResponse
