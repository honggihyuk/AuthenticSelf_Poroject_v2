    }

    class StyleAnalyzeRequest {
      <<PydanticModel>>
      +roomId: str ^[A-Za-z0-9_-]{1,64}$
      +photoUrl: str ^file://.+
      %% FR-2
    }

    class StyleAnalysisResponse {
      <<PydanticModel>>
      +roomId: str
      +status: Literal["OK"]
      +style: StyleLabel
      +confidence: float [0,1]
      +scores: Dict[StyleLabel, float]
      +processingMs: int
      %% FR-2 / AC-2
    }

    class StyleLabel {
      <<Literal>>
      MODERN | SIMPLE | CLASSIC | SCANDINAVIAN | INDUSTRIAL
      %% FR-2 / AC-4 (no CURRENT)
    }

    class StyleClassifier {
      <<Analyzer / ACTIVE PLACEHOLDER>>
      +LABELS : Tuple[str,...]
      +analyze(image_path: Path) StyleAnalysisResult
      %% FR-3 / FR-4 / AC-8
      %% sha256(bytes)[:20] -> five 4-char chunks -> normalise -> argmax
      %% TODO(ml) ResNet / CLIP / transformer
    }

    class StyleAnalysisResult {
      <<dataclass frozen>>
      +style: str
      +confidence: float
      +scores: Dict[str,float]
      %% FR-4
    }

    class default_style_classifier {
      <<FastAPI Depends>>
      +() StyleClassifier
      %% FR-3 - DI factory, fresh instance per request
    }

    class ColorExtractor {
      <<Analyzer / REAL - unchanged>>
    }
    class DimensionsEstimator {
      <<Analyzer / placeholder - unchanged>>
    }
    class AnalyzerBundle {
      +dimensions: DimensionsEstimator
      +color: ColorExtractor
      +style: StyleClassifier
    }
    class default_analyzers {
      <<FastAPI Depends>>
      +() AnalyzerBundle
    }

    class SpaceAnalyzeRequest {
      <<PydanticModel - unchanged>>
    }
    class SpaceAnalysisResponse {
      <<PydanticModel - unchanged>>
    }
    class Dimensions {
      <<PydanticModel - unchanged>>
    }
    class ErrorResponse {
      <<PydanticModel>>
      +errorCode: str
      +message: str
      +roomId: Optional[str]
    }

    class AnalyzerError {
      <<Exception>>
    }
    class ImageNotFoundError
    class ImageReadError
    class AnalysisError

    AnalyzerError <|-- ImageNotFoundError
    AnalyzerError <|-- ImageReadError
    AnalyzerError <|-- AnalysisError

    FastAPIApp ..> StyleRouter : include_router
    StyleRouter ..> StyleAnalyzeRequest : validates
    StyleRouter ..> StyleAnalysisResponse : returns
    StyleRouter ..> StyleClassifier : Depends(default_style_classifier)
    StyleRouter ..> AnalyzerError : raises
    default_style_classifier ..> StyleClassifier : creates
    StyleClassifier ..> StyleAnalysisResult : returns
    StyleAnalysisResponse ..> StyleLabel : field type
    AnalyzerBundle o-- StyleClassifier
    AnalyzerBundle o-- ColorExtractor
    AnalyzerBundle o-- DimensionsEstimator
