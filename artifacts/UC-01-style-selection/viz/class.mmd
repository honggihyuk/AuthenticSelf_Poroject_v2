    FastAPIApp ..> SpaceAnalyzeRequest : validates
    FastAPIApp ..> SpaceAnalysisResponse : returns
    FastAPIApp ..> Dimensions : composes
    FastAPIApp ..> AnalyzerBundle : Depends

