    }

    class StyleAnalysisRequest {
      <<DTO / record - NEW Task 4>>
      +roomId: String
      +photoUrl: String
    }
    class StyleAnalysisResponse_Spring {
      <<DTO / record - NEW Task 4>>
      +roomId: String
      +status: String
      +style: String
      +confidence: Double
      +scores: Map~String,Double~
