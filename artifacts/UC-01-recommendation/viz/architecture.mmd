    %% =========================================================
    %% Wire edges (DTO / route / table on each edge)
    %% =========================================================

    %% RN -> Spring
    RN_Style -. "navigation.replace('Recommendation', { roomId })" .-> RN_Rec
    RN_Rec ==>|"getRecommendations({baseUrl,userId,roomId,topN:3})"| RN_Api
    RN_Rec ==>|"PREFERRED_STYLE_LABELS[resp.preferredStyle]<br/>+ ' 스타일 추천'"| RN_Types
    RN_Api ==>|"GET /api/v1/spaces/{roomId}/recommendations?topNPerCategory=3<br/>header X-User-Id<br/>body: none"| CTRL_SP

    %% Spring internals
    CTRL_SP ==>|"recommend(roomId,userId,topN)"| ORCH
    CTRL_SP ..>|"RecommendationsApiResponse.from(...)"| API_RESP
    CTRL_SP ..>|"throw SpaceException"| ERR_SP
    ERR_SP --> ADV_SP
    ORCH -->|"findById(roomId)"| REPO_S
    ORCH -->|"findAll()"| REPO_F
    REPO_F --> ENT_F
    ORCH <-->|"get / put / invalidate<br/>CacheKey(roomId, preferredStyle)"| CACHE_R
    ORCH -->|"CompletableFuture.supplyAsync(<br/>() -> client.callRecommend(req),<br/>aiExecutor)"| EXEC
    EXEC -->|"RecommendationRequest"| CLIENT_R
    CLIENT_R ..>|"throws AIException"| ERR_AI
    CLIENT_R ..>|"marshals via Jackson"| DTOS_R

    %% Spring -> Python (cross-process)
    CLIENT_R ==>|"POST /recommend/furniture<br/>{roomId,userId,space{detectedObjects:[]},<br/>preferredStyle,catalog[28],topNPerCategory}"| PY_APP
    PY_APP --> PY_RECO_ROUTE
    PY_RECO_ROUTE -->|"rank(catalog, resolved_style, room, detected, topN)"| PY_RECO_ANA
    PY_RECO_ROUTE ..>|"raise CatalogEmptyError / RecommendationFailedError"| PY_ERRS
    PY_RECO_ROUTE ..>|"validates via Pydantic"| PY_SCHEMAS

    %% Response back
    PY_APP ==>|"200 {roomId,status,resolvedStyle,<br/>generatedAt,recommendations{4},warning,processingMs}<br/>OR 422 {errorCode,message,roomId}"| CLIENT_R
    CLIENT_R ==>|"RecommendationResponse (Jackson-deserialized)"| ORCH
    ORCH ==>|"OrchestratorResult(response,preferredStyle,cacheHit)"| CTRL_SP
    CTRL_SP ==>|"200 RecommendationsApiResponse<br/>OR 4xx/5xx {errorCode,message,correlationId}"| RN_Api
    RN_Api ==>|"RecommendationResponse (shape-asserted)"| RN_Rec

    %% Data layer
    FW --> MY
    MY --- T_S
    MY --- T_F
    MY --- HIST
    REPO_S --> MY
    REPO_F --> MY

    %% Pending wiring
    RN_Rec -.->|"(UC-02 Task 6)<br/>POST /api/v1/wishlist"| Backend
    ENT_F -.->|"(AR Task 8)<br/>consumes widthCm/lengthCm/heightCm + imageUrl"| Client

